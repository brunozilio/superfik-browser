new file mode 100644
index 0000000000..255407df79
--- /dev/null
+++ b/third_party/blink/renderer/platform/superfik/canvas.h
@@ -0,0 +1,61 @@
+// Copyright 2026 Superfik contributors. BSD-style license.
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_SUPERFIK_CANVAS_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_SUPERFIK_CANVAS_H_
+#include "third_party/blink/renderer/platform/superfik/profile.h"
+#include "base/compiler_specific.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace blink::superfik {
+// Quantize only exported readbacks, never the displayed backing store.
+// The pattern depends on canonical RGB values, so cropped reads, WebGL's
+// inverted row order and image exports agree. Reapplying is idempotent.
+inline void CanvasBytes(base::span<uint8_t> data, int width, int height, size_t row_bytes) {
+  if (!Enabled("canvas") || !Seed()) return;
+  for (int y = 0; y < height; ++y) {
+    for (int x = 0; x < width; ++x) {
+      auto pixel = data.subspan(y * row_bytes + x * 4, 4);
+      if (!pixel[3]) continue;
+      const uint32_t key = (pixel[0] >> 2) | ((pixel[1] >> 2) << 6) | ((pixel[2] >> 2) << 12);
+      const uint32_t pattern = Mix(Seed() ^ key);
+      for (int c = 0; c < 3; ++c)
+        pixel[c] = (pixel[c] & ~3U) | ((pattern >> (c * 2)) & 3U);
+    }
+  }
+}
+
+inline sk_sp<SkImage> CanvasImage(sk_sp<SkImage> actual) {
+  if (!Enabled("canvas") || !Seed() || !actual) return actual;
+  const auto info = SkImageInfo::Make(actual->width(), actual->height(), kRGBA_8888_SkColorType,
+                                     kUnpremul_SkAlphaType, actual->refColorSpace());
+  const size_t row_bytes = info.minRowBytes();
+  const size_t size = info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(size)) return actual;
+  auto data = SkData::MakeUninitialized(size);
+  if (!data || !actual->readPixels(info, data->writable_data(), row_bytes, 0, 0)) return actual;
+  // SAFETY: SkData owns exactly size bytes in this new allocation.
+  auto bytes = UNSAFE_BUFFERS(base::span<uint8_t>(base::unchecked,
+      static_cast<uint8_t*>(data->writable_data()), size));
+  CanvasBytes(bytes, info.width(), info.height(), row_bytes);
+  return SkImages::RasterFromData(info, std::move(data), row_bytes);
+}
+
+inline void CanvasPixmap(const SkPixmap& target) {
+  if (!Enabled("canvas") || !Seed() || !target.addr()) return;
+  const auto info = SkImageInfo::Make(target.width(), target.height(), kRGBA_8888_SkColorType,
+                                     kUnpremul_SkAlphaType, target.refColorSpace());
+  const size_t row_bytes = info.minRowBytes();
+  const size_t size = info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(size)) return;
+  auto data = SkData::MakeUninitialized(size);
+  if (!data || !target.readPixels(info, data->writable_data(), row_bytes, 0, 0)) return;
+  // SAFETY: SkData owns exactly size bytes in this new allocation.
+  auto bytes = UNSAFE_BUFFERS(base::span<uint8_t>(base::unchecked,
+      static_cast<uint8_t*>(data->writable_data()), size));
+  CanvasBytes(bytes, info.width(), info.height(), row_bytes);
+  SkPixmap exported(info, data->data(), row_bytes);
+  exported.readPixels(target.info(), target.writable_addr(), target.rowBytes());
+}
+}  // namespace blink::superfik
+#endif
diff --git a/third_party/blink/renderer/platform/superfik/profile.h b/third_party/blink/renderer/platform/superfik/profile.h
new file mode 100644
index 0000000000..4e282c2c72
--- /dev/null
+++ b/third_party/blink/renderer/platform/superfik/profile.h
@@ -0,0 +1,95 @@
+// Copyright 2026 Superfik contributors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_SUPERFIK_PROFILE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_SUPERFIK_PROFILE_H_
+
+#include <cstdint>
+#include <bit>
+#include <cmath>
+#include <algorithm>
+#include <string>
+#include <string_view>
+#include "base/base64.h"
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/values.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink::superfik {
+// Supplied only by this renderer's BrowserContext, never by page script.
+inline const base::DictValue& Configuration() {
+  static const base::NoDestructor<base::DictValue> configuration([] {
+    std::string json;
+    const auto encoded = base::CommandLine::ForCurrentProcess()->
+        GetSwitchValueASCII("superfik-profile");
+    if (encoded.size() > 90000 || !base::Base64Decode(encoded, &json))
+      return base::DictValue();
+    auto value = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+    if (!value || !value->FindBool("enabled").value_or(false))
+      return base::DictValue();
+    return std::move(*value);
+  }());
+  return *configuration;
+}
+
+inline bool Enabled(std::string_view key) {
+  return Configuration().FindBool(key).value_or(false);
+}
+
+inline uint32_t Seed() {
+  const double value = Configuration().FindDouble("seed").value_or(0);
+  return std::isfinite(value) && value >= 1 && value <= UINT32_MAX
+             ? static_cast<uint32_t>(value) : 0;
+}
+
+inline String Gpu(std::string_view key, const String& actual) {
+  const auto* gpu = Configuration().FindDict("gpu");
+  const auto* value = gpu ? gpu->FindString(key) : nullptr;
+  return value && !value->empty() ? String::FromUtf8(*value) : actual;
+}
+
+inline uint32_t Mix(uint32_t value) {
+  value ^= value >> 16; value *= 0x7feb352dU;
+  value ^= value >> 15; value *= 0x846ca68bU;
+  return value ^ (value >> 16);
+}
+
+inline void Audio(base::span<float> samples, uint32_t channel = 0) {
+  if (!Enabled("audio") || !Seed()) return;
+  for (size_t i = 0; i < samples.size(); ++i) {
+    if (samples[i] == 0 || !std::isfinite(samples[i])) continue;
+    auto bits = std::bit_cast<uint32_t>(samples[i]);
+    bits = (bits & ~15U) | (Mix(Seed() ^ channel ^ static_cast<uint32_t>(i)) & 15U);
+    samples[i] = std::bit_cast<float>(bits);
+  }
+}
+
+inline void AudioBytes(base::span<uint8_t> samples) {
+  if (!Enabled("audio") || !Seed()) return;
+  for (size_t i = 0; i < samples.size(); ++i) {
+    if (samples[i] == 0 || samples[i] == 128) continue;
+    samples[i] = (samples[i] & ~1U) | (Mix(Seed() ^ static_cast<uint32_t>(i)) & 1U);
+  }
+}
+
+inline bool FontAllowed(const String& family) {
+  const auto* fonts = Configuration().FindList("fonts");
+  if (!fonts || fonts->empty()) return true;
+  std::string name = family.FoldCase().Utf8();
+  std::erase(name, ' ');
+  // Keep native last-resort/system/emoji fallback usable. Web fonts do not
+  // pass through this local-font matching gate.
+  for (const auto* fallback : {"times", "lucidagrande", "applecoloremoji", "system-ui", "-apple-system"})
+    if (name == fallback) return true;
+  for (const auto& font : *fonts) {
+    if (!font.is_string()) continue;
+    std::string allowed = String::FromUtf8(font.GetString()).FoldCase().Utf8();
+    std::erase(allowed, ' ');
+    if (name == allowed || name.starts_with(allowed + "-")) return true;
+  }
+  return false;
+}
+}  // namespace blink::superfik
+#endif
