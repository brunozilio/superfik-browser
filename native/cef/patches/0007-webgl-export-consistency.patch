diff --git a/third_party/blink/renderer/platform/superfik/canvas.h b/third_party/blink/renderer/platform/superfik/canvas.h
index f1697c7511..f0c6eac790 100644
--- a/third_party/blink/renderer/platform/superfik/canvas.h
+++ b/third_party/blink/renderer/platform/superfik/canvas.h
@@ -12,13 +12,14 @@ namespace blink::superfik {
 // The pattern depends on canonical RGB values, so cropped reads, WebGL's
 // inverted row order and image exports agree. Reapplying is idempotent.
 inline void CanvasBytes(base::span<uint8_t> data, int width, int height, size_t row_bytes) {
-  if (!Enabled("canvas") || !Seed()) return;
+  const uint32_t seed = Seed();
+  if (!Enabled("canvas") || !seed) return;
   for (int y = 0; y < height; ++y) {
     for (int x = 0; x < width; ++x) {
       auto pixel = data.subspan(y * row_bytes + x * 4).first<4>();
       if (!pixel[3]) continue;
       const uint32_t key = (pixel[0] >> 2) | ((pixel[1] >> 2) << 6) | ((pixel[2] >> 2) << 12);
-      const uint32_t pattern = Mix(Seed() ^ key);
+      const uint32_t pattern = Mix(seed ^ key);
       for (int c = 0; c < 3; ++c)
         pixel[c] = (pixel[c] & ~3U) | ((pattern >> (c * 2)) & 3U);
     }
@@ -57,5 +58,16 @@ inline void CanvasPixmap(const SkPixmap& target) {
   SkPixmap exported(info, data->data(), row_bytes);
   exported.readPixels(target.info(), target.writable_addr(), target.rowBytes());
 }
+
+inline void CanvasReadback(base::span<uint8_t> data, int width, int height,
+                           size_t row_bytes, SkColorType color_type) {
+  if (!Enabled("canvas")) return;
+  if (color_type == kRGBA_8888_SkColorType) {
+    CanvasBytes(data, width, height, row_bytes);
+  } else {
+    const auto info = SkImageInfo::Make(width, height, color_type, kUnpremul_SkAlphaType);
+    CanvasPixmap(SkPixmap(info, data.data(), row_bytes));
+  }
+}
 }  // namespace blink::superfik
 #endif
