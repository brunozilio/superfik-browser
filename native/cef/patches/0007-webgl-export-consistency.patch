+      const auto pack = GetPackPixelStoreParams();
+      const size_t pixel_bytes = type == GL_UNSIGNED_BYTE ? 4 : (type == GL_FLOAT ? 16 : 8);
+      const size_t row_bytes = ((static_cast<size_t>(pack.row_length ? pack.row_length : width) * pixel_bytes + pack.alignment - 1) / pack.alignment) * pack.alignment;
+      const size_t skip = pack.skip_rows * row_bytes + pack.skip_pixels * pixel_bytes;
+      const size_t bytes = skip + (height - 1) * row_bytes + width * pixel_bytes;
+      Vector<uint8_t> exported(base::checked_cast<wtf_size_t>(bytes));
+      ContextGL()->GetBufferSubDataCHROMIUM(GL_PIXEL_PACK_BUFFER, offset,
+                                           static_cast<GLsizeiptr>(bytes), exported.data());
+      const auto color_type = type == GL_UNSIGNED_BYTE ? kRGBA_8888_SkColorType : (type == GL_FLOAT ? kRGBA_F32_SkColorType : kRGBA_F16_SkColorType);
+      superfik::CanvasReadback(base::span(exported).subspan(skip), width, height, row_bytes, color_type);
+      ContextGL()->BufferSubData(GL_PIXEL_PACK_BUFFER, offset,
+                                 static_cast<GLsizeiptr>(bytes), exported.data());
+    }
   }
 }
 
