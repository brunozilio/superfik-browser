+std::optional<double> ChromeContentBrowserClientCef::GetDeviceMemoryOverride(
+    content::BrowserContext* context) {
+  auto* profile = context ? Profile::FromBrowserContext(context) : nullptr;
+  if (!profile || !profile->GetPrefs()->GetBoolean("superfik.identity.enabled")) {
+    return std::nullopt;
+  }
+  const double memory =
+      profile->GetPrefs()->GetDouble("superfik.identity.device_memory");
+  if (memory == 0.25 || memory == 0.5 || memory == 1 || memory == 2 ||
+      memory == 4 || memory == 8) {
+    return memory;
+  }
+  return std::nullopt;
+}
